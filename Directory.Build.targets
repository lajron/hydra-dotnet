        <ProjectReference Include="$(MSBuildThisFileDirectory)Hydra.Analyzers/Hydra.Analyzers/Hydra.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>
</Project>
